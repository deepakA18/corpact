# Postgres (docker compose up -d)
DATABASE_URL=postgres://parityfi:parityfi-dev@127.0.0.1:54329/parityfi

# Chain access. Public mainnet works for development but is rate-limited; see docs/adr/0002.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RPC_MAX_CONCURRENCY=2
RPC_MIN_INTERVAL_MS=150
# Independent reconciliation provider (PLAN Appendix B). Wallet balances and held mints' multiplier state are
# cross-checked here; a disagreement pauses conversion for what it affects. Must be a different provider
# (origin) from SOLANA_RPC_URL. Leave unset to disable; monitoring then warns.
# RECONCILIATION_RPC_URL=https://second-provider.example

# Issuer feed. `fixtures` reads fixtures/xstocks/recorded-20260913 and makes no network calls.
# `live` calls api.xstocks.fi — do not enable until the data-rights question is resolved.
ISSUER_SOURCE=fixtures
# ISSUER_FIXTURES_DIR=/absolute/path/to/recording

# Worker
MINT_POLL_SECONDS=45
WALLET_MAX_SIGNATURES=5000
# ALLOWLIST_SYMBOLS=SPYx,KOx,HONx

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
