{
  "name": "@corpact/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./access": "./src/access.ts",
    "./keys": "./src/keys.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "keys": "tsx --env-file-if-exists=../../.env src/cli.ts keys",
    "openapi:export": "tsx src/export-openapi.ts",
    "openapi:check": "tsx src/export-openapi.ts --check",
    "tenants": "tsx --env-file-if-exists=../../.env src/cli.ts tenants"
  },
  "dependencies": {
    "@corpact/accounting": "workspace:*",
    "@corpact/client": "workspace:*",
    "@corpact/db": "workspace:*",
    "@corpact/domain": "workspace:*",
    "@corpact/solana": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@solana/kit": "8.3.0",
    "fastify": "5.12.4",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
